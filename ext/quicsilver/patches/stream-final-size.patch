diff --git a/src/core/stream.c b/src/core/stream.c
--- a/src/core/stream.c
+++ b/src/core/stream.c
@@ -800,6 +800,35 @@ QuicStreamParamGet(
         Status = QUIC_STATUS_SUCCESS;
         break;
 
+    case QUIC_PARAM_STREAM_FINAL_SIZE:
+
+        if (*BufferLength < sizeof(uint64_t)) {
+            *BufferLength = sizeof(uint64_t);
+            Status = QUIC_STATUS_BUFFER_TOO_SMALL;
+            break;
+        }
+
+        if (Buffer == NULL) {
+            Status = QUIC_STATUS_INVALID_PARAMETER;
+            break;
+        }
+
+        //
+        // RecvMaxLength is UINT64_MAX until a FIN or RESET_STREAM settles the
+        // final size (RFC 9000 4.5). Report that as an invalid state rather
+        // than handing the caller a sentinel it has to know about.
+        //
+        if (!Stream->Flags.Started || Stream->RecvMaxLength == UINT64_MAX) {
+            Status = QUIC_STATUS_INVALID_STATE;
+            break;
+        }
+
+        *BufferLength = sizeof(uint64_t);
+        *(uint64_t*)Buffer = Stream->RecvMaxLength;
+
+        Status = QUIC_STATUS_SUCCESS;
+        break;
+
