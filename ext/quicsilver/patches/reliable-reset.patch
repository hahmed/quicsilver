new file mode 100644
index 000000000..8c4e15294
--- /dev/null
+++ b/src/core/unittest/ReliableResetTest.cpp
@@ -0,0 +1,33 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+#include "main.h"
+
+extern "C" void QuicStreamProcessReliableResetFrame(
+    QUIC_STREAM*, uint64_t, QUIC_VAR_INT, QUIC_VAR_INT);
+
+TEST(ReliableResetTest, FinalSizeIsChargedOnceWhileWaitingForPrefix)
+{
+    QUIC_CONNECTION Connection = {};
+    Connection.State.ReliableResetStreamNegotiated = TRUE;
+    Connection.Send.MaxData = 100;
+    QUIC_STREAM Stream = {};
+    Stream.Connection = &Connection;
+    Stream.RecvMaxLength = UINT64_MAX;
+    Stream.MaxAllowedRecvOffset = 100;
+
+    QuicStreamProcessReliableResetFrame(&Stream, 50, 42, 10);
+    EXPECT_EQ(50u, Connection.Send.OrderedStreamBytesReceived);
+    EXPECT_EQ(50u, Stream.RecvMaxLength);
+    EXPECT_EQ(10u, Stream.ReliableOffsetRecv);
+    EXPECT_EQ(100u, Connection.Send.MaxData); // No credit returned before consumption.
+
+    QuicStreamProcessReliableResetFrame(&Stream, 50, 42, 5);
+    EXPECT_EQ(50u, Connection.Send.OrderedStreamBytesReceived);
+    EXPECT_EQ(50u, Stream.RecvMaxLength);
+    EXPECT_EQ(5u, Stream.ReliableOffsetRecv);
+
+    // A reordered copy must not increase the reliable boundary or charge again.
+    QuicStreamProcessReliableResetFrame(&Stream, 50, 42, 10);
+    EXPECT_EQ(50u, Connection.Send.OrderedStreamBytesReceived);
+    EXPECT_EQ(5u, Stream.ReliableOffsetRecv);
+}
